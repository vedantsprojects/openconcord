{
  "name": "open-concord",
  "version": "1.0.0",
  "description": "An open-source alternative Discord client built from Discord's own architecture",
  "author": "Open Concord Team",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build:dev": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "start:dev": "npm run build:dev && electron . --enable-logging",
    "start:prod": "npm run build:prod && electron . /Users/macos/Downloads/arambh-opencode-local-harness-v2/workspace/Discord/openconcord/dist",
    "test": "jest --coverage --silent",
    "test:verbose": "jest --coverage",
    "test:watch": "jest --watch",
    "test:types": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --ignore-pattern __tests__",
    "lint:fix": "eslint src --ext .ts,.tsx --ignore-pattern __tests__ --fix",
    "package:mac": "npm run build:prod && electron-builder --mac --arm64 --publish never --ignore-launcher",
    "package:win": "npm run build:prod && electron-builder --win --x64 --publish never --ignore-launcher",
    "package:linux": "npm run build:prod && electron-builder --linux --x64 --publish never --ignore-launcher",
    "package:all": "npm run package:mac && npm run package:win && npm run package:linux"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "electron": "^28.0.0",
    "electron-log": "^5.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "events": "^3.3.0",
    "fast-xml-parser": "^4.3.6",
    "glob": "^10.3.10",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.3",
    "lodash": "^4.17.21",
    "lru-cache": "^10.2.0",
    "nanoid": "^4.0.2",
    "node-fetch": "^3.3.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "serialize-javascript": "^6.0.1",
    "underscore": "^1.13.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "worker-loader": "^3.0.8",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.6",
    "@types/prop-types": "^15.7.12",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/serialize-javascript": "^5.0.4",
    "@types/uuid": "^9.0.7",
    "@types/xml2js": "^0.4.13",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "build": {
    "appId": "com.openconcord.app",
    "productName": "Open Concord",
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "resources/icons"
      },
      {
        "from": "resources/scripts",
        "to": "resources/scripts"
      }
    ]
  }
}
